---
import { CONTACT_EMAIL, CONTACT_MAILTO, DASHBOARD_URL } from '../lib/contact';
import BrandLogo from './BrandLogo.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-[oklch(0.92_0.003_0)] py-16">
  <div class="container">
    <div class="grid md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-2 no-underline mb-4" aria-label="Difunde inicio">
          <BrandLogo className="h-7 w-auto" />
        </a>
        <p class="text-sm text-muted max-w-sm">
          Plataforma multicanal de mensajería empresarial. WhatsApp, Email y automatizaciones en un solo lugar.
        </p>
        <a
          href={CONTACT_MAILTO}
          class="mt-4 inline-flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 no-underline font-medium"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {CONTACT_EMAIL}
        </a>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-ink uppercase tracking-widest mb-4">Producto</h4>
        <ul class="space-y-2.5">
          <li><a href="/#beneficios" class="text-sm text-muted hover:text-ink transition-colors no-underline">Beneficios</a></li>
          <li><a href="/#producto" class="text-sm text-muted hover:text-ink transition-colors no-underline">Producto</a></li>
          <li><a href="/#precios" class="text-sm text-muted hover:text-ink transition-colors no-underline">Precios</a></li>
          <li><a href="/#faq" class="text-sm text-muted hover:text-ink transition-colors no-underline">FAQ</a></li>
          <li><a href="/#contacto" class="text-sm text-muted hover:text-ink transition-colors no-underline">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-ink uppercase tracking-widest mb-4">Legal</h4>
        <ul class="space-y-2.5">
          <li><a href="/privacidad" class="text-sm text-muted hover:text-ink transition-colors no-underline">Privacidad</a></li>
          <li><a href="/terminos" class="text-sm text-muted hover:text-ink transition-colors no-underline">Términos</a></li>
          <li><a href={CONTACT_MAILTO} class="text-sm text-muted hover:text-ink transition-colors no-underline">Soporte</a></li>
          <li><a href={DASHBOARD_URL} class="text-sm text-muted hover:text-ink transition-colors no-underline">Panel</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-[oklch(0.92_0.003_0)] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-muted">&copy; {year} Difunde. Todos los derechos reservados.</p>
      <a
        href={CONTACT_MAILTO}
        class="text-xs text-muted hover:text-ink transition-colors no-underline"
      >
        {CONTACT_EMAIL}
      </a>
    </div>
  </div>
</footer>
