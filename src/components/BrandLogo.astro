---
interface Props {
  className?: string;
  variant?: "brand" | "monochrome" | "light";
  showWordmark?: boolean;
  isotypeOnly?: boolean;
}

const {
  className = "h-7",
  variant = "brand",
  showWordmark = true,
  isotypeOnly = false,
} = Astro.props;

const darkBlueFill =
  variant === "light"
    ? "currentColor"
    : variant === "monochrome"
      ? "#70194B"
      : "#70194B";
const darkBlue2Fill =
  variant === "light"
    ? "currentColor"
    : variant === "monochrome"
      ? "#70194B"
      : "#70194b";
const textFill =
  variant === "light"
    ? "currentColor"
    : variant === "monochrome"
      ? "#70194B"
      : "#70194B";
const pinkFill = variant === "monochrome" ? "#70194B" : "#B92A72";
